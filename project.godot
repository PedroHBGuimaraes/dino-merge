; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="dino-merge"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/bg_color=Color(0.15, 0.08, 0.05, 1)
boot_splash/stretch_mode=0
boot_splash/use_filter=false
boot_splash/image="res://assets/app_icon/app_icon.png"
config/icon="res://assets/app_icon/app_icon.png"

[autoload]

LocaleManager="*res://scripts/locale_manager.gd"
GameManager="*res://scripts/game_manager.gd"
DinoChain="*res://scripts/dino_chain.gd"
Achievements="*res://scripts/achievements.gd"
AdsManager="*res://scenes/AdsManager.tscn"
SceneTransition="*res://scenes/SceneTransition.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/AdmobPlugin/plugin.cfg")

[display]

window/size/viewport_width=400
window/size/viewport_height=700
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://assets/ui/theme/main_theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://translations.pt.translation", "res://translations.en.translation", "res://translations.es.translation", "res://translations.de.translation", "res://translations.fr.translation")
locale/fallback="pt"

[physics]

3d/physics_engine="Jolt Physics"
2d/default_gravity=1600

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
