{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/gd_format_lint.py",
            "timeout": 20,
            "statusMessage": "Formatting + linting GDScript..."
          }
        ]
      }
    ]
  }
}
